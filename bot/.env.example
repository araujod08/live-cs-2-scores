# ─── CS2 Telegram Bot ───────────────────────────────
# Copie este arquivo para .env.local e preencha os valores.

# Token do bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chave da PandaScore API (mesma usada pelo site)
PANDASCORE_API_KEY=your_pandascore_api_key_here

# ─── Servidor de controle (usado pelo painel admin web) ───
# Token compartilhado entre o bot e o painel admin. Gere um valor forte, ex:
#   openssl rand -hex 32
# Deve ser IGUAL ao BOT_CONTROL_TOKEN configurado no projeto Vercel.
BOT_CONTROL_TOKEN=your_shared_control_token_here

# Porta e host do servidor de controle (opcional)
BOT_CONTROL_PORT=8080
BOT_CONTROL_HOST=0.0.0.0
